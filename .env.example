# Copy this file to .env and fill in real values.
# NEVER commit .env — it is ignored by Git.

# Which PC this checkout runs on.
# home   = production PC: voice, render, installs
# office = text/skills/docs only; no installs, production tools optional
PC_ROLE=home

# Absolute path to a working ffmpeg.exe (optional; config/defaults.json is used otherwise)
# FFMPEG_PATH=

# Absolute path to a working ffprobe.exe (optional; config/defaults.json is used otherwise)
# FFPROBE_PATH=

# YouTube Data API v3 (trend-finder reads this key; upload/analytics later)
# Create it in Google Cloud Console and enable "YouTube Data API v3".
# Never commit .env or paste the key into chat.
YOUTUBE_API_KEY=

# Facebook / Meta access token (for Reels publishing later)
FACEBOOK_ACCESS_TOKEN=

# Optional AI API key (for research/localization later)
OPENAI_API_KEY=
