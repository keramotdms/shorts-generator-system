{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "captions.json",
  "title": "Word-level caption timings",
  "type": "object",
  "required": ["language", "captions"],
  "properties": {
    "language": {"type": "string", "enum": ["bn", "en"]},
    "total_duration_sec": {"type": "number", "minimum": 0},
    "source": {"type": "string"},
    "audio_file": {"type": "string"},
    "captions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "start", "end", "scene_number"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "scene_number": {"type": "integer", "minimum": 0},
          "safe_zone": {"type": "object"},
          "max_chars_per_line": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
