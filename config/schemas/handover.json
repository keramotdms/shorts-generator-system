{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "handover.json",
  "title": "Handover readiness check",
  "type": "object",
  "required": ["ready", "missing", "project"],
  "properties": {
    "ready": {"type": "boolean"},
    "missing": {
      "type": "array",
      "items": {"type": "string", "minLength": 3}
    },
    "project": {"type": "string", "minLength": 1}
  }
}
