{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "inventory.json",
  "title": "Asset or file inventory",
  "type": "object",
  "required": ["status", "skill", "project", "generated_at", "entries", "summary"],
  "properties": {
    "status": {"type": "string", "enum": ["PASS", "WARN", "FAIL"]},
    "skill": {"type": "string", "minLength": 2},
    "project": {"type": "string", "minLength": 2},
    "generated_at": {"type": "string", "minLength": 10},
    "language": {"type": "string", "minLength": 2},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "version", "purpose", "state"],
        "properties": {
          "path": {"type": "string", "minLength": 3},
          "version": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 3},
          "state": {"type": "string", "enum": ["active", "draft", "archive"]}
        }
      }
    },
    "summary": {"type": "string", "minLength": 10}
  }
}
