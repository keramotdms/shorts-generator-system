{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "latest_script.json",
  "title": "Shorts script",
  "type": "object",
  "required": ["language", "title", "hook", "total_duration_sec", "scenes"],
  "properties": {
    "language": {"type": "string", "enum": ["bn", "en"]},
    "title": {"type": "string", "minLength": 3},
    "hook": {"type": "string", "minLength": 5},
    "total_duration_sec": {"type": "number", "minimum": 30, "maximum": 60},
    "scenes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["scene_number", "narration", "visual_prompt", "highlight_words"],
        "properties": {
          "scene_number": {"type": "integer", "minimum": 1},
          "narration": {"type": "string", "minLength": 3},
          "visual_prompt": {"type": "string", "minLength": 8},
          "highlight_words": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "duration_sec": {"type": "number", "minimum": 1, "maximum": 15}
        }
      }
    }
  }
}
