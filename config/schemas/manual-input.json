{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manual-input.json",
  "title": "Report built from a manually exported data file",
  "type": "object",
  "required": ["status", "skill", "project", "generated_at", "api_needed", "source_file", "rows", "summary"],
  "properties": {
    "status": {"type": "string", "enum": ["PASS", "WARN", "FAIL"]},
    "skill": {"type": "string", "minLength": 2},
    "project": {"type": "string", "minLength": 2},
    "generated_at": {"type": "string", "minLength": 10},
    "api_needed": {"type": "string", "enum": ["later"]},
    "source_file": {"type": "string", "minLength": 10},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "summary": {"type": "string", "minLength": 10}
  }
}
