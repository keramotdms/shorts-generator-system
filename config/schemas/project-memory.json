{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-memory.json",
  "title": "Project memory snapshot",
  "type": "object",
  "required": ["version", "style", "voice", "channel"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "style": {
      "type": "object",
      "required": ["tone", "visual_style", "palette", "font"],
      "properties": {
        "tone": {"type": "string", "minLength": 3},
        "visual_style": {"type": "string", "minLength": 3},
        "palette": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        },
        "font": {"type": "string", "minLength": 3}
      }
    },
    "voice": {
      "type": "object",
      "required": ["language", "default_gender"],
      "properties": {
        "language": {"type": "string", "enum": ["bn", "en"]},
        "default_gender": {"type": "string", "enum": ["male", "female", "neutral"]}
      }
    },
    "channel": {
      "type": "object",
      "required": ["niche", "language"],
      "properties": {
        "niche": {"type": "string", "minLength": 3},
        "language": {"type": "string", "enum": ["bn", "en"]}
      }
    }
  }
}
