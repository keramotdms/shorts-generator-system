{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "story.json",
  "title": "Story concept",
  "type": "object",
  "required": ["niche", "audience", "angle", "hook_seed", "beats"],
  "properties": {
    "niche": {"type": "string", "minLength": 3},
    "audience": {"type": "string", "minLength": 3},
    "angle": {"type": "string", "minLength": 5},
    "hook_seed": {"type": "string", "minLength": 5},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "beats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["beat", "purpose"],
        "properties": {
          "beat": {"type": "integer", "minimum": 1},
          "purpose": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
