{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trend-report.json",
  "title": "Location-based trend report",
  "type": "object",
  "required": ["region", "source_files", "trends"],
  "properties": {
    "region": {"type": "string", "minLength": 3},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "trends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["platform", "topic", "signals", "observed_on", "source_file", "scores"],
        "properties": {
          "platform": {"type": "string", "enum": ["youtube-shorts", "facebook-reels"]},
          "topic": {"type": "string", "minLength": 3},
          "signals": {"type": "object"},
          "observed_on": {"type": "string", "minLength": 8},
          "source_file": {"type": "string", "minLength": 3},
          "scores": {
            "type": "object",
            "required": ["freshness", "local", "reuse"],
            "properties": {
              "freshness": {"type": "number", "minimum": 1, "maximum": 5},
              "local": {"type": "number", "minimum": 1, "maximum": 5},
              "reuse": {"type": "number", "minimum": 1, "maximum": 5}
            }
          }
        }
      }
    }
  }
}
